{
  "name": "@mp-consulting/homebridge-ewelink",
  "displayName": "eWeLink",
  "version": "1.2.0",
  "type": "module",
  "description": "Homebridge plugin to integrate eWeLink devices into HomeKit",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "watch": "npm run build && npm link && nodemon",
    "copy:ui-assets": "mp-ui-kit-copy --vendor",
    "build": "npm run copy:ui-assets && rimraf ./dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run build",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --access=public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com --access=public",
    "publish:all": "npm run publish:npm && npm run publish:github",
    "detect-api-changes": "npx tsx scripts/detect-api-changes.ts",
    "detect-api-changes:save": "npx tsx scripts/detect-api-changes.ts --save"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "ewelink",
    "sonoff",
    "zigbee",
    "rf",
    "hoobs",
    "smart-home"
  ],
  "author": "mp-consulting",
  "license": "MIT",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "homepage": "https://github.com/mp-consulting/homebridge-ewelink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-ewelink.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-ewelink/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mp-consulting/homebridge-ai-core": "file:../homebridge-mcp-server/packages/ai-core",
    "axios": "^1.20.0",
    "bonjour-service": "^1.4.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "file:../homebridge-ui-kit",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.29.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
